# Server-side only. Never prefix these with VITE_ — that would bake them into
# the browser bundle. Read by api/detect.js, and by the dev middleware in
# vite.config.js. In production set them in the Vercel project settings.

# Roboflow inference-only key.
ROBOFLOW_INFERENCE_KEY=

# Optional. Defaults to the workflow in api/detect.js.
# ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/<workspace>/workflows/<workflow-id>

# Optional. The ROOM segmentation workflow — the one that proposes room outlines
# on upload. A different model answering a different question to the furniture
# one above, so it is a separate URL. Defaults to DEFAULT_ROOMS_URL in
# api/detect.js.
# ROBOFLOW_ROOMS_WORKFLOW_URL=https://serverless.roboflow.com/<workspace>/workflows/<workflow-id>

# For the OpenAI bed-detection route (provider=openai) and the eval harness.
# Same rule as above: no VITE_ prefix, server-side only.
OPENAI_API_KEY=

# Optional. Defaults to DEFAULT_MODEL in src/lib/openaiDetect.js.
# `node tools/eval-detect.mjs --list-models` says what this key can actually see.
# OPENAI_VISION_MODEL=
