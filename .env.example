# Server-side only. Never prefix these with VITE_ — that would bake them into
# the browser bundle. Read by api/detect.js, and by the dev middleware in
# vite.config.js. In production set them in the Vercel project settings.

# Roboflow inference-only key.
ROBOFLOW_INFERENCE_KEY=

# Optional. Defaults to the workflow in api/detect.js.
# ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/<workspace>/workflows/<workflow-id>

# Optional. The ROOM segmentation workflow — the one that proposes room outlines
# on upload. A different model answering a different question to the furniture
# one above, so it is a separate URL. Defaults to DEFAULT_ROOMS_URL in
# api/detect.js.
# ROBOFLOW_ROOMS_WORKFLOW_URL=https://serverless.roboflow.com/<workspace>/workflows/<workflow-id>

# Optional. The DOOR workflow — the one that finds the doors on upload so one of
# them can be clicked as the drawing's ruler. A third model answering a third
# question, so a third URL. Defaults to DEFAULT_DOORS_URL in api/detect.js.
# ROBOFLOW_DOORS_WORKFLOW_URL=https://serverless.roboflow.com/<workspace>/workflows/<workflow-id>

# For the OpenAI bed-detection route (provider=openai) and the eval harness.
# Same rule as above: no VITE_ prefix, server-side only.
OPENAI_API_KEY=

# Optional. Defaults to DEFAULT_MODEL in src/lib/openaiDetect.js.
# `node tools/eval-detect.mjs --list-models` says what this key can actually see.
# OPENAI_VISION_MODEL=

# Optional. THE RENDER PASS ONLY — the two calls that read uploaded renders and
# place shelves, art and panelling on the plan. It has its own name because it is
# the one pass looking at PHOTOGRAPHS rather than line drawings, which is a
# harder read, so it should be able to sit on a better model without moving every
# other call on the sheet at the same time. Defaults to WALL_MODEL in
# src/lib/wallPrompt.js — which is also where both of its prompts live.
# OPENAI_WALL_MODEL=

# ---------------------------------------------------------------------------
# SUPABASE. Read the prefix rule above once more, because this block is the ONE
# place in this repo where VITE_ is correct.
#
# Everything above is a secret the browser must never see. The two names below
# are the opposite: they are designed to ship in the bundle, and what protects
# the data is the row-level security in supabase/migrations/0001_init.sql, not
# the key being hidden. If a table has no policy, adding one is the fix — hiding
# the key is not available as a fix.
#
# SUPABASE_SECRET_KEY (in .env.local, server-side, bypasses RLS entirely) must
# NEVER be given a VITE_ prefix.
#
# THAT KEY IS NOW ACTUALLY USED, by api/admin.js and by nothing else. The admin
# console reads across accounts, which is precisely what RLS is there to stop, so
# it cannot go through the browser client at all — the endpoint verifies the
# caller's token, re-reads their `profiles.role` from the database, and only then
# queries with the key. See the header of api/admin.js.
#
# IN PRODUCTION these three must be set in the Vercel project settings, or the
# console answers 500 and says so:
#
#   SUPABASE_SECRET_KEY   the service key. Server-side. Never VITE_.
#   SUPABASE_URL          or SUPABASE_PROJECT_ID; falls back to VITE_SUPABASE_URL.
#   SUPABASE_ANON_KEY     falls back to VITE_SUPABASE_ANON_KEY. Used ONLY to ask
#                         Supabase to validate the caller's token, which is a
#                         public operation — this one is not a secret.
# ---------------------------------------------------------------------------

# The project URL. Either give it in full…
VITE_SUPABASE_URL=https://<project-id>.supabase.co
# …or just the id, and the client builds the URL (src/lib/supabase.js). Handy
# because .env.local already carries SUPABASE_PROJECT_ID for the server side.
# VITE_SUPABASE_PROJECT_ID=

# The anon / publishable key. Settings → API in the Supabase dashboard.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# RAZORPAY — the till. See api/billing.js and api/razorpay-webhook.js.
#
# NONE OF THESE IS VITE_ PREFIXED, and that includes RZP_KEY, which is a public
# value printed on every Razorpay checkout ever opened. It stays here because it
# is not a CONSTANT: the test key and the live key are different strings, and a
# key baked into the bundle is how a production build quietly opens a test-mode
# payment window. /api/billing returns it per checkout instead.
# ---------------------------------------------------------------------------

# Dashboard -> Account & Settings -> API Keys.
RZP_KEY=
RZP_SECRET=

# HOW A MONTH IS SOLD.
#   subscription  (default) Razorpay holds a mandate — UPI Autopay, card,
#                 eMandate — and charges again by itself. This is what "$10 a
#                 month" means. Needs the Subscriptions product enabled on the
#                 account, and a plan id per tier (below).
#   order         one prepaid month, and the user comes back to renew. Works on
#                 every Razorpay account with no activation and no plan ids. Use
#                 this if Subscriptions or international payments are not
#                 switched on yet.
# RZP_MODE=subscription

# The currency the account charges in. USD needs international payments enabled;
# an India-only account should set INR here and give explicit rupee prices below.
# RZP_CURRENCY=USD

# THE PLAN IDS, for subscription mode only. Create them once with
#   node tools/razorpay-plans.mjs
# which prints exactly these two lines for you to paste back.
# Either spelling is read — RZP_PLAN_<TIER> or RZP_<TIER>_PLAN.
RZP_PLAN_STARTER=
RZP_PLAN_PRO=

# THE PRICE IN MINOR UNITS (cents, or paise), per tier.
#
# Not derived from the dollar figure in src/lib/plans.js, on purpose. $10 is not
# ₹1,000 and it is not today's mid-market rate either — it is whatever reads as a
# sensible price in the market being sold to. Left blank with RZP_CURRENCY=USD it
# falls back to the dollar price; with any other currency it MUST be set or
# checkout refuses rather than guessing.
#   USD:  1000 / 3000        (= $10 / $30)
#   INR:  89900 / 249900     (= ₹899 / ₹2,499)
# RZP_AMOUNT_STARTER=1000
# RZP_AMOUNT_PRO=3000

# Dashboard -> Settings -> Webhooks. The same string in both places, and it is
# the ONLY thing that authenticates a webhook — see api/razorpay-webhook.js.
# Subscribe to: subscription.activated, subscription.charged, subscription.pending,
#               subscription.halted, subscription.cancelled, subscription.completed,
#               payment.captured
RZP_WEBHOOK_SECRET=
